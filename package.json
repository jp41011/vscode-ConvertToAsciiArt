{
  "name": "converttoasciiart",
  "publisher": "BitBelt",
  "displayName": "Convert To ASCII Art",
  "description": "Utility extension to convert text to ASCII art.",
  "version": "1.1.1",
  "engines": {
    "vscode": "^1.35.0"
  },
  "icon": "resources/icon_ConvertToASCIIArt.png",
  "galleryBanner": {
    "color": "#005696",
    "theme": "dark"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "ASCII Art",
    "Converter",
    "Convert to ASCII Art",
    "Text to ASCII Art"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jp41011/vscode-ConvertToAsciiArt"
  },
  "activationEvents": [
    "onCommand:extension.convertToAsciiArt",
    "onCommand:extension.convertToAsciiArt_Favorite",
    "onCommand:extension.convertToAsciiArt_Favorite_Comment"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.convertToAsciiArt",
        "title": "Convert to ASCII Art"
      },
      {
        "command": "extension.convertToAsciiArt_Favorite",
        "title": "Convert to ASCII Art with Favorite Font"
      },
      {
        "command": "extension.convertToAsciiArt_Favorite_Comment",
        "title": "Convert to ASCII Art with Favorite Font (Comment)"
      }
    ],
    "keybindings": [
      {
        "command": "extension.convertToAsciiArt",
        "key": "Ctrl+Alt+a",
        "mac": "Cmd+Alt+a",
        "when": "editorHasSelection"
      },
      {
        "command": "extension.convertToAsciiArt_Favorite",
        "key": "Ctrl+Alt+1",
        "mac": "Cmd+Alt+1",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Convert To ASCII Art - Configuration",
      "properties": {
        "convertToAsciiArt.favoriteFont": {
          "type": "string",
          "default": "Standard",
          "description": "Favorite ASCII font (case sensitive)."
        },
        "convertToAsciiArt.favoriteHorizontalLayout": {
          "type": "string",
          "enum": [
            "default",
            "full",
            "fitted",
            "controlled smushing",
            "universal smushing"
          ],
          "default": "default",
          "description": "A string value that indicates the horizontal layout to use with all fonts."
        },
        "convertToAsciiArt.favoriteVerticalLayout": {
          "type": "string",
          "enum": [
            "default",
            "full",
            "fitted",
            "controlled smushing",
            "universal smushing"
          ],
          "default": "default",
          "description": "A string value that indicates the vertical layout to use with all fonts."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run bundle && npm run copy-figlet-fonts",
    "bundle": "esbuild ./src/extension.ts --bundle --platform=node --format=cjs --target=es6 --external:vscode --outfile=out/extension.js --sourcemap",
    "copy-figlet-fonts": "node ./scripts/copy-figlet-fonts.js",
    "watch": "npm run copy-figlet-fonts && tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.35.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.11",
    "figlet": "^1.11.0",
    "typescript": "^5.9.3"
  }
}
